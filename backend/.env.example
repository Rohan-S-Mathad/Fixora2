# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
PROJECT_NAME="Fixora API"
API_V1_STR="/api/v1"

# Database Configuration
# Default uses local SQLite with async driver, or PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/fixora
DATABASE_URL=sqlite+aiosqlite:///./fixora.db
SYNC_DATABASE_URL=sqlite:///./fixora.db

# Security & JWT Auth
SECRET_KEY=fixora-super-secret-dev-jwt-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional Gemini Key)
GEMINI_API_KEY=

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://*.run.app"]
